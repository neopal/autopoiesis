{
  "buildCommand": "node scripts/build-public-catalog.mjs",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/studies/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/studio/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/studio/data/catalog-public.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/api/vote/?$",
      "status": 410,
      "headers": {
        "Cache-Control": "public, max-age=86400, s-maxage=86400"
      }
    }
  ],
